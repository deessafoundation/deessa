*.mp4 filter=lfs diff=lfs merge=lfs -text
# Public website videos must be regular Git files so Vercel can serve them
# directly during a deployment rather than receiving an LFS pointer file.
# Every MP4 under public/ is covered by pattern, current and future — never list
# individual filenames here, that is how understanding-a-new-friend.mp4 got lost.
public/*.mp4 -filter -diff -merge -text
public/**/*.mp4 -filter -diff -merge -text
