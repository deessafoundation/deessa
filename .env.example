# ==============================================================================
# DEESSA FOUNDATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` for local development.
# 2. For Production, configure these keys in Vercel Dashboard → Settings → Environment Variables.
# 3. NEVER commit `.env.local` or any file containing real API keys or service role secrets.
# ==============================================================================

# ==============================================================================
# 1. SITE & DOMAIN CONFIGURATION
# ==============================================================================
# Local: http://localhost:3000
# Production: https://deessafoundation.com (Required for Stripe redirects, webhooks & receipt URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# 2. SUPABASE BACKEND (PostgreSQL / Auth / Storage)
# ==============================================================================
# Get these from: Supabase Dashboard → Project Settings → API
#
# 1. Supabase Project REST URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Anon / Publishable Key (Client-safe — restricted by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Service Role Secret Key (Server-side ONLY — bypasses RLS for trusted server actions)
# ⚠️ CRITICAL: Never expose this key to browser client or git. Rotate in Supabase dashboard if exposed.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. JWT Secret (Supabase Dashboard → Project Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Direct Database Connection Pooling (Supabase Dashboard → Settings → Database)
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=db.your-project-id.supabase.co
POSTGRES_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
POSTGRES_PRISMA_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:6543/postgres?pgbouncer=true

# ==============================================================================
# 3. ONLINE DONATION RELEASE GATE
# ==============================================================================
# Server-side safety gate: Prevents public online checkout until explicitly enabled.
# false = Public form displays testing notice and directs users to direct bank transfer.
# true  = Opens live gateway checkouts once provider credentials pass readiness validation.
DONATION_ONLINE_CHECKOUT_ENABLED=false

# Payment engine execution mode:
# live = Real provider transactions (use sk_test_ keys in staging, sk_live_ in production)
# mock = Bypasses network requests for offline UI testing
PAYMENT_MODE=live

# ==============================================================================
# 4. STRIPE PAYMENT GATEWAY (International Cards / Apple Pay / Google Pay)
# ==============================================================================
# Get keys from: https://dashboard.stripe.com/apikeys
#
# Client Publishable Key (Safe for browser):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # or pk_live_... for production

# Secret API Key (Server-only):
STRIPE_SECRET_KEY=sk_test_... # or sk_live_... for production

# Webhook Signing Secret:
# Local dev: Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: Stripe Dashboard → Developers → Webhooks → Add endpoint (https://deessafoundation.com/api/webhooks/stripe)
# Select events: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed,
#                charge.refunded, charge.dispute.created, invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# 5. ESEWA PAYMENT GATEWAY v2 (Nepal)
# ==============================================================================
# Test credentials: https://developer.esewa.com.np/
# If these variables are unset or incomplete, eSewa is automatically hidden from donors.
#
# Merchant Code (Test: EPAYTEST)
ESEWA_MERCHANT_ID=EPAYTEST

# Secret Key for HMAC-SHA256 signature verification (Test: 8gBm/:&EnhH.1/q)
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Base Gateway URL:
# Staging: https://rc-epay.esewa.com.np
# Production: https://epay.esewa.com.np
ESEWA_BASE_URL=https://rc-epay.esewa.com.np

# Callback URLs:
ESEWA_SUCCESS_URL=http://localhost:3000/api/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:3000/api/payments/esewa/failure

# ==============================================================================
# 6. KHALTI PAYMENT GATEWAY (Nepal)
# ==============================================================================
# Test credentials: https://admin.khalti.com/
# If these variables are unset or incomplete, Khalti is automatically hidden from donors.
#
# Secret API Key (e.g. Key test_secret_key_... or live_secret_key_...):
KHALTI_SECRET_KEY=test_secret_key_...

# Khalti API Base URL:
# Staging: https://dev.khalti.com/api/v2
# Production: https://khalti.com/api/v2
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# Return / Redirect URL:
KHALTI_RETURN_URL=http://localhost:3000/api/payments/khalti/verify
KHALTI_SANDBOX_MODE=true

# ==============================================================================
# 7. EMAIL DELIVERY (Receipts, Alerts & Contact)
# ==============================================================================
# Requires Gmail with 2-Step Verification enabled and a 16-character App Password.
# Generate at: https://myaccount.google.com/apppasswords
GOOGLE_EMAIL=foundation@gmail.com
GOOGLE_APP_PASSWORD=abcd1234efgh5678

# ==============================================================================
# 8. INTERNAL SECURITY SECRETS & CRON
# ==============================================================================
# 1. Receipt Token Secret: Used to sign time-limited JWT URLs for donor receipt downloads.
# Generate with: openssl rand -base64 32
# ⚠️ Rotating this invalidates previously emailed download links.
RECEIPT_TOKEN_SECRET=replace_with_random_32_byte_string_minimum

# 2. Vercel Cron Secret: Authenticates /api/cron/reconcile-payments
# Generate with: openssl rand -hex 24
CRON_SECRET=replace_with_secure_random_hex_string

# 3. Optional: API Key for programmatic receipt resending
RECEIPT_RESEND_API_KEY=optional_custom_api_key

# 4. Super Admin Provisioning Key:
# Required to create the initial super administrator account at /admin/setup
ADMIN_SETUP_KEY=replace_with_secure_random_admin_setup_key
ADMIN_EMAIL=admin@deessafoundation.com

# ==============================================================================
# 9. TEXT-TO-SPEECH (Accessibility "Listen" — Nepali Neural Voice)
# ==============================================================================
# Optional: Set this to a Google Cloud API key with "Cloud Text-to-Speech API" enabled
# for high-fidelity Nepali neural voice synthesis (ne-NP-Wavenet-A).
GOOGLE_TTS_API_KEY=

# ==============================================================================
# 10. SYSTEM FEATURE FLAGS
# ==============================================================================
NEXT_PUBLIC_ENABLE_DONATIONS=true
NEXT_PUBLIC_ENABLE_STRIPE=true
NEXT_PUBLIC_ENABLE_KHALTI=false
LEGACY_RECEIPT_ACCESS=false
