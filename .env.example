# Copy to .env (shared/dev defaults) or .env.local (local overrides, wins over .env).
# Production values are set in Vercel → Settings → Environment Variables, never here.
# Verify with: .\scripts\test-credentials.ps1

# ===========================================
# SITE CONFIGURATION
# ===========================================
# Local: http://localhost:3000    Production: https://deessa.org
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_STATUS=development

# ===========================================
# SUPABASE DATABASE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Publishable Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Secret Keys (server-side only)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ===========================================
# POSTGRES DATABASE CONFIGURATION
# ===========================================
POSTGRES_DATABASE=your_postgres_database_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=your_postgres_host_here
POSTGRES_URL=your_postgres_url_here
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here

# ===========================================
# PAYMENT MODE CONFIGURATION
# ===========================================
# live = real provider APIs (use sk_test_ keys for safe testing)
# mock = no provider calls at all
PAYMENT_MODE=live

# ===========================================
# STRIPE PAYMENT CONFIGURATION
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_here
STRIPE_SECRET_KEY=sk_test_or_sk_live_here
# Local: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: from Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# ===========================================
# KHALTI PAYMENT GATEWAY (NEPAL)
# ===========================================
# Leave KHALTI_SECRET_KEY unset to keep the dormant Khalti code unreachable;
# setting it would put Khalti back on the donate form.
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:3000/payments/khalti/return
KHALTI_SANDBOX_MODE=true

# ===========================================
# ESEWA PAYMENT GATEWAY (NEPAL)
# ===========================================
# Optional — provider is hidden if these are unset
ESEWA_MERCHANT_ID=your_esewa_merchant_id_here
ESEWA_SECRET_KEY=your_esewa_secret_key_here
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:3000/api/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:3000/api/payments/esewa/failure

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Gmail + app password — used for receipts, contact, support, alerts
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_APP_PASSWORD=your_16_char_app_password

# ===========================================
# SECURITY SECRETS
# ===========================================
# Generate with: .\scripts\generate-secrets.ps1
# Use DIFFERENT values per environment. Rotating RECEIPT_TOKEN_SECRET
# invalidates every receipt download link already emailed out.
RECEIPT_TOKEN_SECRET=base64_32_byte_random_here
CRON_SECRET=hex_32_byte_random_here

# Receipt Resend API Key (optional, for programmatic access)
RECEIPT_RESEND_API_KEY=your_receipt_resend_api_key_here

# ===========================================
# RATE LIMITING
# ===========================================
RESEND_PAYMENT_IP_LIMIT=5
RESEND_PAYMENT_REG_LIMIT=3
RESEND_PAYMENT_WINDOW_MINUTES=60
VERIFY_REGISTRATION_LIMIT=60
VERIFY_REGISTRATION_WINDOW_MINUTES=1

# Legacy Receipt Access (deprecated)
# Set to "true" to allow old receipt URLs without tokens during migration
# Set to "false" to enforce token-based authentication (recommended)
LEGACY_RECEIPT_ACCESS=false

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
ADMIN_EMAIL=admin@deessa.org

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_DONATIONS=true
NEXT_PUBLIC_ENABLE_KHALTI=true
NEXT_PUBLIC_ENABLE_STRIPE=true
